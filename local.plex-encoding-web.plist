<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the web UI (webui.py, port 7979) natively on the Mac and keeps it running.
  Template: YOUR_USER/scripts/encoding is replaced with the actual folder
  during installation, see the wiki page "Setup A: native on macOS". Expects the virtual environment .venv.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.plex-encoding-web</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/scripts/encoding/.venv/bin/python3</string>
    <string>/Users/YOUR_USER/scripts/encoding/webui.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/scripts/encoding/logs/webui.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/scripts/encoding/logs/webui.log</string>
</dict>
</plist>
