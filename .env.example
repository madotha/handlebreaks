# Folders on the Mac for docker-compose.yml. Copy to .env and adjust.
# .env is listed in .gitignore.

# Folder that contains your shares (mounted read-only at /media), e.g. with
# Movies/ and Shows/ inside: they become /media/Movies and /media/Shows
HOST_MEDIA_DIR="/Volumes/Media"

# Output folder for finished files
HOST_ENCODED_DIR="/Users/YOUR_USER/Downloads/_ENCODED"

# Optional: folder in the Obsidian vault for the notes
#HOST_NOTE_DIR="/Users/YOUR_USER/Library/Mobile Documents/iCloud~md~obsidian/Documents/YOUR_VAULT/PLEX"

# docker-compose.hybrid.yml only: program folder of the native installation
#HOST_APP_DIR="/Users/YOUR_USER/scripts/encoding"

# Time zone of the container (e.g. Europe/Zurich), so logs and stored times use your
# local time. The web UI always shows times in your browser's time zone.
#TZ="Europe/Zurich"

# Port of the web UI on the Mac
#WEB_PORT=7979
