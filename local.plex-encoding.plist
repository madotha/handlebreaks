<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Startet encode.sh automatisch, sobald im Ordner queue/ ein Auftrag liegt.
  Installation:  siehe ANLEITUNG.md
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.plex-encoding</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/YOUR_USER/scripts/encoding/encode.sh</string>
  </array>
  <key>QueueDirectories</key>
  <array>
    <string>/Users/YOUR_USER/scripts/encoding/queue</string>
  </array>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/scripts/encoding/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/scripts/encoding/logs/launchd.log</string>
</dict>
</plist>
