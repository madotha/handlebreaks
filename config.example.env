# ─────────────────────────────────────────────────────────────────────────────
# Lokale Einstellungen für encoding.py und encode.sh
#
# Kopieren und anpassen:   cp config.example.env config.env
# config.env ist in .gitignore eingetragen und bleibt nur auf diesem Rechner.
#
# Werte in doppelten Anführungszeichen angeben und "$HOME" statt ~ verwenden.
# Bei Ordnern sind mehrere Pfade mit ":" getrennt möglich. Es gilt jeweils der
# erste, der existiert (z. B. echter macOS-Pfad, danach ein Ersatzpfad in einer
# anderen Umgebung).
# ─────────────────────────────────────────────────────────────────────────────

# Bibliothek auf dem NAS (wird nur gelesen, nie verändert)
FILME_DIR="/Volumes/Media/Filme"
SERIEN_DIR="/Volumes/Media/Serien"

# Zielordner für fertige Dateien (wird bei Bedarf angelegt)
ENCODED_DIR="$HOME/Downloads/_ENCODED"

# Ordner im Obsidian-Vault für "Encoding To-Do.md" und "Encoding Status.md".
# Leer lassen, wenn keine Notizen geschrieben werden sollen.
NOTE_DIR="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/YOUR_VAULT/PLEX"

# HandBrake-Preset: exportierte Datei und deren interner Name ("PresetName").
# PRESET_FILE leer lassen, um preset.json neben encode.sh zu verwenden.
PRESET_FILE=""
PRESET_NAME="1080p x265 (Ger/Eng) RF20"

# Status-Notiz während des Encodings jede Minute aktualisieren (1 = an, 0 = aus)
STATUS_NOTE_ENABLED=0
