# ─────────────────────────────────────────────────────────────────────────────
# Local settings for encoding.py, encode.sh and the web UI
#
# Copy and adjust:   cp config.example.env config.env
# config.env is listed in .gitignore and stays on this machine.
# In the Docker container, config.env is created automatically on first start
# and can be edited in the web UI under "Settings".
#
# Put values in double quotes and use "$HOME" instead of ~.
# Folder settings may list several paths separated by ":". The first one that
# exists is used. The defaults therefore list the macOS path first and the path
# inside the Docker container (/media, /encoded, /notes) second.
# ─────────────────────────────────────────────────────────────────────────────

# Library on the NAS (read only, never modified)
MOVIES_DIR="/Volumes/Media/Movies:/media/Movies"
SHOWS_DIR="/Volumes/Media/Shows:/media/Shows"

# More library folders: add MOVIES_DIR_2, MOVIES_DIR_3, … or SHOWS_DIR_2, … They
# appear as "Movies 2", "Shows 2" etc., for example:
#   e.g. MOVIES_DIR_2="/Volumes/Archive/Movies:/media/Movies 2"
# Keep each folder's number: it is part of the stored file keys. To remove a
# folder, comment its line out; a commented-out number is never reused.

# Output folder for finished files (created if missing)
ENCODED_DIR="$HOME/Downloads/_ENCODED:/encoded"

# Folder in the Obsidian vault for "Encoding To-Do.md" and "Encoding Status.md".
# Leave empty if no notes should be written.
NOTE_DIR="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/YOUR_VAULT/PLEX:/notes"

# HandBrake preset: exported file and its internal name ("PresetName").
# Leave PRESET_FILE empty to use preset.json next to encode.sh.
PRESET_FILE=""
PRESET_NAME="1080p x265 (Ger/Eng) RF20"

# Update the status note every minute while encoding (1 = on, 0 = off)
STATUS_NOTE_ENABLED=0

# Docker only: encode inside the container (1), or only run web UI and scans (0),
# e.g. when the Mac keeps encoding natively with launchd and encode.sh.
WORKER_ENABLED=1
