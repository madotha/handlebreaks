# ─────────────────────────────────────────────────────────────────────────────
# Local settings of Handlebreaks: encoding.py, encode.sh and the web UI
#
# Copy and adjust:   cp config.example.env config.env
# config.env is listed in .gitignore and stays on this machine.
# In the Docker container, config.env is created automatically on first start
# and can be edited in the web UI under "Settings".
#
# Put values in double quotes and use "$HOME" instead of ~.
# Folder settings may list several paths separated by ":". The first one that
# exists is used. The defaults therefore list the macOS path first and the path
# inside the Docker container (/media, /encoded, /notes) second.
# ─────────────────────────────────────────────────────────────────────────────

# Shares: the library folders to scan (read only, never modified). Add more as
# SHARE_2, SHARE_3, … each with an optional name and preset, for example:
#   e.g. SHARE_2="/Volumes/Archive/Shows:/media/Archive"
#   e.g. SHARE_2_NAME="Archive"
#   e.g. SHARE_2_PRESET="1080p-x265-ger-eng-rf20"
# SHARE_N_PRESET is the id of a preset (file name in presets/ without .json);
# empty = DEFAULT_PRESET. Keep each share's number: it is part of the stored file
# keys. To remove a share, comment its lines out; a commented-out number is never reused.
SHARE_1="/Volumes/Media/Movies:/media/Movies"
SHARE_1_NAME="Movies"
SHARE_1_PRESET=""
SHARE_2="/Volumes/Media/Shows:/media/Shows"
SHARE_2_NAME="Shows"
SHARE_2_PRESET=""

# Preset used for every share without its own. Presets are managed in the web UI
# (Presets page) and stored in presets/ in the data folder. Empty = the bundled
# preset.json is imported on first run and set here.
DEFAULT_PRESET=""

# Output folder for finished files (created if missing)
ENCODED_DIR="$HOME/Downloads/_ENCODED:/encoded"

# Folder in the Obsidian vault for "Encoding To-Do.md" and "Encoding Status.md".
# Leave empty if no notes should be written.
NOTE_DIR="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/YOUR_VAULT/PLEX:/notes"

# Automatic rescan of all shares, in minutes: a scan starts once the last scan
# (manual or automatic) is this old. Only new or changed files are read with
# ffprobe. Runs while the web UI runs (always in Docker). 0 = off.
SCAN_INTERVAL=0

# How the web UI shows dates (always followed by the time): YYYY-MM-DD (default),
# DD-MM-YYYY, MM-DD-YYYY, DD.MM.YYYY, DD/MM/YYYY or MM/DD/YYYY.
DATE_FORMAT=YYYY-MM-DD
# Appearance of the web UI (Settings -> Appearance). Theme: auto (follow the system), light
# or dark; the header's theme button overrides it for one browser. Accent: amber, blue,
# teal, violet, pink or graphite. Text size: small, normal or large. Density: comfortable
# or compact. Contrast: normal or more. Animations: system (follow the system) or reduce.
UI_THEME=auto
UI_ACCENT=amber
UI_TEXT_SIZE=normal
UI_DENSITY=comfortable
UI_CONTRAST=normal
UI_MOTION=system

# Files page (both editable under Settings → Pages).
# Filters applied when the page opens, as a query string: codec (group:good, group:other,
# unknown or a codec name such as h264), status (offer, queued, waiting, h265, bad,
# skipped, baseline; several allowed) and added (a range of ADDED_FILTERS).
# Empty = all files. Example: codec=group%3Aother&added=24h
FILES_DEFAULT_FILTERS=""
# The "Added" choices, label=range pairs separated by ;. A range is <newer>-<older>,
# each a number with h (hours), d (days), w (weeks), m (months) or y (years), either
# side optional: 24h = last 24 hours, 3m-1m = 1 to 3 months ago, -1y = older than a year.
# Missing = the three below; empty = none (the custom date range is always offered).
ADDED_FILTERS="Last 24 hours=24h;Last 7 days=7d;Last 30 days=30d"

# Notifications in the web UI: popups in the corner of every open page.
# Seconds until a popup hides by itself (0 = only when you close it).
NOTIFY_SECONDS=8
# 1 = failed encodes, replaces and scans stay until you close them.
NOTIFY_ERRORS_STAY=1
# What to notify about, separated by spaces (none = nothing): encodes (finished or
# failed), runs (worker runs of two or more files finished or interrupted), replaces,
# scans (automatic ones only when they find new files), shares (offline / back),
# cleanup (kept originals deleted automatically), api (API tokens about to expire,
# changes made through the API).
NOTIFY_EVENTS="encodes runs replaces scans shares cleanup api"

# How long the Status page's History shows results and finished replaces, in days.
# Older entries are only hidden, nothing is deleted. 0 = always show them.
HISTORY_KEEP_DAYS=30

# Default of "Keep the original" in the Replace dialogs (each replace can still change
# it): 1 = move the original to <output folder>/.replaced, 0 = delete it right after
# the encode replaced it.
KEEP_ORIGINALS=1

# Delete the originals that "Replace…" kept (in <output folder>/.replaced, see Status →
# Kept originals) permanently once they were kept this many days. Checked hourly while
# the web UI runs, or run "python3 encoding.py purge-originals". 0 = never delete them.
KEEP_ORIGINALS_DAYS=0

# How many files ffprobe reads at the same time during scans. Empty = number of CPUs.
FFPROBE_WORKERS=""

# Update the status note every minute while encoding (1 = on, 0 = off)
STATUS_NOTE_ENABLED=0

# "Replace…" suggests a new file name: the codec tag in the original name (h264, x264,
# H.264, AVC, XviD …) becomes the encode's codec. Codec (as ffprobe names it) = tag in the
# name; empty = hevc=x265 av1=AV1 vvc=VVC h264=x264.
RENAME_CODEC_TAGS=""
# Optional: your own release group, replacing the one after the codec tag
# (e.g. "donm": "…h264-NTB.mkv" -> "…x265-donm.mkv"). Empty = keep the group.
RENAME_GROUP=""
# Add the encode's quality after the release group: "x265-donm.rf20" (constant quality,
# RF 20) or "x265-donm.avg2000" (average bitrate, 2000 kbit/s). 1 = on (default), 0 = off.
RENAME_QUALITY=1
# Language tag from the audio tracks (1 = on, 0 = off, the default): Replace… reads the
# encode's audio languages and puts the matching tag into the suggested name, in place of
# the original's language words (german, dl, subbed, geresp …). RENAME_LANG_MAIN is the main
# language (ISO 639-2 code, ger = deu); RENAME_LANG_MULTI is used for it plus another
# language, RENAME_LANG_ONLY for it alone. Without main-language audio: no tag
# (RENAME_LANG_OTHER=none) or the first track's language (original, e.g. "norwegian"),
# plus RENAME_LANG_SUBS if the subtitles are in the main language (empty = nothing).
# RENAME_LANG_TOKENS: the language words to replace, separated by spaces (empty = built-in list).
RENAME_LANGUAGES=0
RENAME_LANG_MAIN="ger"
RENAME_LANG_MULTI="german.dl"
RENAME_LANG_ONLY="german"
RENAME_LANG_OTHER="none"
RENAME_LANG_SUBS=""
RENAME_LANG_TOKENS=""

# Plex: after "Replace…", the web UI makes Plex scan the file's folder (once for all
# replaces in it; files replaced under the same name are also analyzed) and checks that
# Plex lists the new file. Leave empty to skip. PLEX_TOKEN is a secret: find it with
#   defaults read com.plexapp.plexmediaserver PlexOnlineToken   (on the Plex server Mac)
# Several URLs separated by spaces are tried in order, e.g. for the mixed setup:
#   PLEX_URL="http://127.0.0.1:32400 http://host.docker.internal:32400"
PLEX_URL=""
PLEX_TOKEN=""
# Only if Plex sees the library under other paths than the worker (e.g. Plex runs on the
# NAS): worker path=Plex path, several separated by ";". Empty = the same paths.
#   PLEX_PATH_MAP="/Users/me/nfs-shares/PlexMedia=/volume1/PlexMedia"
PLEX_PATH_MAP=""

# Docker only: encode inside the container (1), or only run web UI and scans (0),
# e.g. when the Mac keeps encoding natively with launchd and encode.sh.
WORKER_ENABLED=1

# Login of the web UI. The account itself (user name, password hash) is in auth.json in
# the data folder, set on the first visit with the setup code from the web UI's log, or
# with "python3 webui.py --set-password".
# Sign in with user name and password (1) or not (0). 0 only takes effect once single
# sign-on below has worked; the environment variable AUTH_PASSWORD_LOGIN wins over this.
AUTH_PASSWORD_LOGIN=1
# How long "Keep me signed in" lasts after the last visit, in days (0 = until the browser
# closes, always).
AUTH_SESSION_DAYS=30

# Single sign-on with OpenID Connect (Pocket ID, Authelia, Authentik, Keycloak …). Register
# Handlebreaks at the provider as a client with the redirect URL
#   http(s)://<the web UI's address>/login/oidc/callback
# Every AUTH_OIDC_ key can also be an environment variable of the same name, which wins
# (e.g. the secret in Docker's environment instead of this file).
AUTH_OIDC_ENABLED=0
# Shown on the sign-in button ("Sign in with Pocket ID")
AUTH_OIDC_NAME=""
# The provider's address, exactly as its /.well-known/openid-configuration names it (https)
AUTH_OIDC_ISSUER=""
AUTH_OIDC_CLIENT_ID=""
# Empty for a public client (PKCE only). A secret: never shown again in the web UI.
AUTH_OIDC_CLIENT_SECRET=""
AUTH_OIDC_SCOPES="openid profile email"
# Who may sign in: user names, e-mail addresses or subject IDs (* = everyone the provider
# lets in), and/or groups from the groups claim (add the scope groups). One of both is needed.
AUTH_OIDC_ALLOWED_USERS=""
AUTH_OIDC_ALLOWED_GROUPS=""
# Only behind a reverse proxy that changes the address: the callback's full public URL.
AUTH_OIDC_REDIRECT_URL=""

# API (Settings → API): 1 = answer requests that carry a valid token (created in the web
# UI or with "python3 webui.py --create-token"), 0 = every /api/ address answers 404.
API_ENABLED=1
# Reverse proxies whose X-Forwarded-For header names the real client, for the allowed
# addresses of a token (addresses or networks separated by spaces). Empty = none.
API_TRUSTED_PROXIES=""
